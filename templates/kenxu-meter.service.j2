[Unit]
Description=Kenxu Xray per-user traffic collector
After=network-online.target {{ kenxu_meter_xray_service | default('xray') }}.service
Wants=network-online.target

[Service]
Type=simple
User=root
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/lib/kenxu-meter/kenxu_meter.py --config /etc/kenxu-meter/config.json
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/kenxu-meter {{ kenxu_meter_xray_config | default('/usr/local/etc/xray/config.json') | dirname }} -/var/lib/kenxu-flow
{% if kenxu_meter_activity_enabled | default(true) | bool %}
# Config validation opens the activity log for writing inside this sandbox.
ReadWritePaths=/var/log/kenxu
{% endif %}

[Install]
WantedBy=multi-user.target
